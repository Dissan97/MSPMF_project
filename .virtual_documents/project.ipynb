def gen_normal(df, axs, i, j):
    mu, sigma = np.mean(df), np.std(df)
    x = np.linspace(df.min(), df.max(), 100)
    axs[i][j].plot(x, norm.pdf(x, 0, 1), 'r-', label="Normale teorica")
    return 'Normal'

def gen_t_student(df, axs, i, j):
    df_hat, loc_hat, scale_hat = t.fit(df)

    x = np.linspace(df.min(), df.max(), 100)
    axs[i][j].plot(x, t.pdf(x, df_hat, loc=loc_hat, scale=scale_hat), 'r-', label="Student-t stimata")
    
    return 'T-Student'

def create_istogram(injector, function=gen_normal):
    size = len(injector.indexes)
    rows = int(size / 2)
    if size == 0:
        return
    if size % 2 != 0:
       rows += 1
    
    fig, axs = plt.subplots(rows, 2, figsize=(15, 20), gridspec_kw={'hspace': 0.2})
    i = 0
    j = 0
    
    for index in injector.indexes:
        df = index.daily_info[IndexMeta.LOG_RETURN_PERCENTAGE]
        name = index.i_name
        if j == 2:
            j = 0
            i += 1
        normal = pd.DataFrame(np.random.normal(loc=0, scale=1, size=int(len(df))))
        normal.index = df.index
        sns.histplot(df, bins=30, kde=True, stat="density", label="Dati", color="blue", ax=axs[i][j])
        title = function(df, axs, i, j)
        axs[i][j].set_title(f'{name} {title}')
        #axs[i].plot(normal)
        axs[i][j].legend()
        j += 1
        
        
    plt.show()






