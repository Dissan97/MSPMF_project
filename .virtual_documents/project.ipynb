class RMGarchUtil:
    
    def __init__(self, injector: Injector, split=0.90):
        self.df: pd.DataFrame = self.concat(injector)
        self.train: pd.DataFrame = pd.DataFrame()
        self.tests: pd.DataFrame = pd.DataFrame()        
        self.make_train_and_test(split=split)
        self.train_residuals: pd.DataFrame = pd.DataFrame()
    
    
    def concat(self, injector) -> pd.DataFrame:       
        dfs = []
        for index in injector.indexes:
            pd_df = pd.DataFrame(index.daily_info[IndexMeta.LOG_RETURN_PERCENTAGE])
            pd_df.columns = [index.i_name]
            dfs.append(pd_df)
        
        df_ret = pd.concat(dfs, axis=1, join='inner')
        df_ret = df_ret.sort_index()
        df_ret = df_ret.ffill()
        return df_ret

        
        
    def make_train_and_test(self, split=0.9):
        cut = int(len(self.df)*split)
        self.train = pd.DataFrame(self.df.iloc[:cut])
        self.test = pd.DataFrame(self.df.iloc[cut:])


