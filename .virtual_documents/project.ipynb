def create_istogram_residuals(garch_util: GarchUtil, function=gen_normal):
    indexes = garch_util.indexes
    size = len(indexes)
    rows = int(size / 2)
    if size == 0:
        return
    if size % 2 != 0:
       rows += 1
    
    fig, axs = plt.subplots(rows, 2, figsize=(15, 20), gridspec_kw={'hspace': 0.75})
    i = 0
    j = 0
    
    for index in injector.indexes:
        df = index.residuals[IndexMeta.GARCH_RESIDUALS]
        name = index.i_name
        if j == 2:
            j = 0
            i += 1
        normal = pd.DataFrame(np.random.normal(loc=0, scale=1, size=int(len(df))))
        normal.index = df.index
        sns.histplot(df, bins=30, kde=True, stat="density", label="Dati", color="blue", ax=axs[i][j])
        title = function(df, axs, i, j)
        axs[i][j].set_title(f'{name} {title}')
        #axs[i].plot(normal)
        axs[i][j].legend()
        j += 1
        
        
    plt.show()



