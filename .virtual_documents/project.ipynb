def plot_bootstrap_band(garch_util: GarchUtil):
    indexes = garch_util.indexes
    fig, axs = plt.subplots(len(indexes), 1, figsize=(20, 45), gridspec_kw={'hspace': 0.8})
    i = 0
    
    for index in indexes:
        q_90, q_10, q_95, q_05, q_99, q_01 = [], [], [], [], [], []

        for j in range(index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'].shape[0]):
            q_10.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.10))
            q_90.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.90))
            q_05.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.05))
            q_95.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.95))
            q_01.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.01))
            q_99.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.99))
        
        # Plotting the bootstrap bands
        axs[i].fill_between(garch_util.tests[index.i_name].index, q_99, q_95, color='red', alpha=0.3, label='Intervallo 99%')
        axs[i].fill_between(garch_util.tests[index.i_name].index, q_95, q_90, color='blue', alpha=0.3, label='Intervallo 95%')
        axs[i].fill_between(garch_util.tests[index.i_name].index, q_90, q_10, color='green', alpha=0.3, label='Intervallo 90%')
        axs[i].fill_between(garch_util.tests[index.i_name].index, q_10, q_05, color='blue', alpha=0.3)
        axs[i].fill_between(garch_util.tests[index.i_name].index, q_05, q_01, color='red', alpha=0.3)
        axs[i].axvline(x=garch_util.tests[index.i_name].index[0], linestyle="dashed", color='black', label='Tests')
        axs[i].plot(garch_util.tests[index.i_name], color='black', alpha=0.5, label='Dati Reali')
        axs[i].plot(garch_util.trains[index.i_name].iloc[int(len(garch_util.trains[index.i_name]) * 0.7):], color='blue', alpha=0.5, label='Train')
        axs[i].set_title(f'{index.i_name} Bootstrap prediction Band')
        axs[i].legend(loc="upper center", bbox_to_anchor=(0.5, -0.4), ncol=3, frameon=True)
        i += 1

    plt.show()


def calculate_band_inside_percentage(garch_util: GarchUtil):
    results = {}
    
    for index in garch_util.indexes:
        q_90, q_10, q_95, q_05, q_99, q_01 = [], [], [], [], [], []

        # Calculate quantiles
        for j in range(index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'].shape[0]):
            q_10.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.10))
            q_90.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.90))
            q_05.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.05))
            q_95.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.95))
            q_01.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.01))
            q_99.append(np.quantile(a=index.model['fGARCH[GARCH(1,1)]']['bootstrap-series'][j], q=0.99))

        # Ensure that quantiles and actual returns are of the same length
        if len(q_10) != len(garch_util.tests[index.i_name]):
            raise ValueError("Quantiles and actual returns have different lengths!")

        # Convert lists to arrays for element-wise operations
        q_10 = np.array([q_10]).T
        q_90 = np.array([q_90]).T
        q_05 = np.array([q_05]).T
        q_95 = np.array([q_95]).T
        q_01 = np.array([q_01]).T
        q_99 = np.array([q_99]).T
        
        # Get actual returns from garch_util
        actual_returns = garch_util.tests[index.i_name].values

        # Compare actual returns to the quantiles
        inside_band_90 = np.sum((actual_returns >= q_10) & (actual_returns <= q_90)) / len(actual_returns)
        inside_band_95 = np.sum((actual_returns >= q_05) & (actual_returns <= q_95)) / len(actual_returns)
        inside_band_99 = np.sum((actual_returns >= q_01) & (actual_returns <= q_99)) / len(actual_returns)

        # Store the results
        results[index.i_name] = {
            "90%": f"{inside_band_90*100:.2f}%",
            "95%": f"{inside_band_95*100:.2f}%",
            "99%": f"{inside_band_99*100:.2f}%",
        }

    return pd.DataFrame(results).T




