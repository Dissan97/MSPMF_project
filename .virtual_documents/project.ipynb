def create_istogram_for_multi(df_multi, function=gen_t_student):
    columns = df_multi.columns
    size = len(columns)
    rows = int(size / 2)
    if size == 0:
        return
    if size % 2 != 0:
       rows += 1
    
    fig, axs = plt.subplots(rows, 2, figsize=(15, 20), gridspec_kw={'hspace': 0.2})
    i = 0
    j = 0
    
    for name in columns:
        df = pd.DataFrame(df_multi[name])
        if j == 2:
            j = 0
            i += 1
        sns.histplot(df, bins=30, kde=True, stat="density", label="Dati", color="blue", ax=axs[i][j])
        title = function(df, axs, i, j)
        axs[i][j].set_title(f'{name} {title}')
        #axs[i].plot(normal)
        axs[i][j].legend()
        j += 1
        
        
    plt.show()


create_istogram_for_multi(df)





